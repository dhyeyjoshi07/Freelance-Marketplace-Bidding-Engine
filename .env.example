# ── Database ───────────────────────────────────────────────
MYSQL_USER=bidforge_user
MYSQL_PASSWORD=bidforge_pass
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bidforge
# Or override the full URL:
# DATABASE_URL=mysql+pymysql://bidforge_user:bidforge_pass@localhost:3306/bidforge

# ── JWT Authentication ─────────────────────────────────────
# IMPORTANT: change this in production!
SECRET_KEY=dev-secret-key-change-in-production

# ── Data Encryption (AES-256 via Fernet) ───────────────────
# Must be exactly 32 bytes for AES-256.
ENCRYPTION_KEY=bidforge-dev-encryption-key-32b!
